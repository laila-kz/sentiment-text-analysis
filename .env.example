# Copy to .env and adjust as needed. Every value is optional; the defaults
# shown here are exactly what the application uses when the variable is unset.
# docker compose reads this file automatically.
#
# Every variable uses the SENTIMENT_ prefix and maps to a field on
# config.Settings.

# --- model runtime ---------------------------------------------------------
SENTIMENT_DEVICE=auto                      # auto | cpu | cuda | cuda:0 | mps
SENTIMENT_CACHE_DIR=./model_cache          # Hugging Face download cache
SENTIMENT_MAX_LENGTH=256                   # tokens per input, truncated
SENTIMENT_BATCH_SIZE=16                    # inputs per forward pass
SENTIMENT_TEMPERATURE=1.0                  # >1 softens, <1 sharpens
SENTIMENT_UNCERTAINTY_THRESHOLD=0.35       # normalised entropy above this = uncertain
SENTIMENT_FP16=false                       # half precision on CUDA
SENTIMENT_PRELOAD_MODELS=                  # comma-separated: sentiment,emotion

# --- api -------------------------------------------------------------------
SENTIMENT_RATE_LIMIT_REQUESTS=60           # 0 disables rate limiting
SENTIMENT_RATE_LIMIT_WINDOW=60
SENTIMENT_MAX_TEXT_LENGTH=10000            # characters per input
SENTIMENT_MAX_BATCH_ITEMS=256              # inputs per request
SENTIMENT_CORS_ORIGINS=http://localhost:8501

# --- observability ---------------------------------------------------------
SENTIMENT_LOG_LEVEL=INFO                   # DEBUG | INFO | WARNING | ERROR
SENTIMENT_LOG_JSON=true                    # JSON lines for log shippers
